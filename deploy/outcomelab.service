[Unit]
Description=OutcomeLab isolated AI reliability laboratory
After=network.target

[Service]
Type=simple
User=outcomelab
Group=outcomelab
WorkingDirectory=/opt/outcomelab/current/backend
Environment=ALLOWED_ORIGINS=https://outcomelab.zhongjiehuang.com
Environment=MAX_SESSIONS=16
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/outcomelab/current/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8011 --workers 1 --no-access-log --no-proxy-headers --limit-concurrency 16 --timeout-keep-alive 5
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
MemoryHigh=256M
MemoryMax=320M
CPUQuota=50%
TasksMax=32

[Install]
WantedBy=multi-user.target
